{
  "name": "ai-auditor",
  "version": "1.0.0",
  "description": "AI Readability Auditor — audita dominios y genera reporte HTML con score de legibilidad para LLMs",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "bin": {
    "ai-auditor": "./auditor.ts"
  },
  "scripts": {
    "audit": "npx tsx auditor.ts",
    "test": "npx tsx --test checks/__tests__/*.test.ts"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "@types/node": "22.19.17"
  }
}
